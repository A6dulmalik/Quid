# Root-level ignores for OS and editor files.
# Package-specific rules stay in backend/.gitignore, frontend/.gitignore and
# quid-contract/.gitignore. Don't move them here.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env files (each package also ignores its own)
.env
.env.local
.env.*.local
